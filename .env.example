# Copia este archivo como .env y reemplaza los valores. NUNCA subas el .env al repositorio.
# Todos los valores de aquí son falsos y solo sirven de ejemplo.

# Cadena de conexión a PostgreSQL (local o Neon)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/rescate_alimentos

# Cadena larga y aleatoria para firmar las sesiones
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Zona horaria de las fechas que se muestran
TZ=America/Bogota

NODE_ENV=development
PORT=3000
