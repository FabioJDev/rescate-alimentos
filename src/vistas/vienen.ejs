<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vienen para nosotros · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Vienen para nosotros</h1>

  <% if (donaciones.length === 0) { %>
    <p class="vacio">No hay donaciones en camino. Pídanlas en «Donaciones para recibir».</p>
  <% } else { %>
    <ul class="lista-donaciones">
      <% donaciones.forEach((d) => { %>
        <li class="tarjeta tarjeta-estado-<%= d.estado %>">
          <p class="tarjeta-titulo"><%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <% if (d.estado === 'asignada') { %>
            <p class="estado estado-asignada"><strong>En camino</strong></p>
            <p>La trae: <strong><%= d.voluntario_nombre %></strong> · <%- include('_telefono', { telefono: d.voluntario_telefono, sinTelefono: 'sin teléfono registrado' }) %></p>
            <p>La tomó a las <%= d.tomadaTexto %>.</p>
          <% } else { %>
            <p class="estado estado-disponible"><strong>Esperando voluntario</strong></p>
            <p>Hora límite para recogerla: <%= d.horaLimiteTexto %></p>
          <% } %>
          <p><a href="/donaciones/<%= d.codigo %>">Ver detalle</a> · <a href="/donaciones/<%= d.codigo %>/retirar-solicitud">Ya no la necesitamos</a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
