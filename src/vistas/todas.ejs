<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Todas las donaciones · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <h1>Todas las donaciones</h1>

  <p class="filtro">
    Filtrar por estado:
    <a href="/todas" <%= estado === null ? 'class=filtro-activo' : '' %>>Todas</a> ·
    <a href="/todas?estado=disponible" <%= estado === 'disponible' ? 'class=filtro-activo' : '' %>>Disponibles</a> ·
    <a href="/todas?estado=asignada" <%= estado === 'asignada' ? 'class=filtro-activo' : '' %>>Asignadas</a> ·
    <a href="/todas?estado=entregada" <%= estado === 'entregada' ? 'class=filtro-activo' : '' %>>Entregadas</a> ·
    <a href="/todas?estado=vencida" <%= estado === 'vencida' ? 'class=filtro-activo' : '' %>>Vencidas</a>
  </p>

  <% if (donaciones.length === 0) { %>
    <p class="vacio">No hay donaciones con ese estado.</p>
  <% } else { %>
    <p><%= donaciones.length %> donación(es)</p>
    <ul class="lista-donaciones">
      <% donaciones.forEach((d) => { %>
        <li class="tarjeta">
          <p class="tarjeta-titulo"><%= d.codigo %> · <%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <p class="estado <%= d.estadoClase %>"><strong><%= d.estadoTexto %></strong></p>
          <p>Donante: <%= d.donante_nombre %></p>
          <p>Hora límite: <%= d.horaLimiteTexto %></p>
          <p><a href="/donaciones/<%= d.codigo %>">Ver estado e historial</a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <p><a href="/">Volver al inicio</a></p>
</body>
</html>
