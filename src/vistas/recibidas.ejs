<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Recibidas · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Recibidas (últimos 30 días)</h1>

  <% if (donaciones.length === 0) { %>
    <p class="vacio">No han recibido donaciones en los últimos 30 días.</p>
  <% } else { %>
    <ul class="lista-donaciones">
      <% donaciones.forEach((d) => { %>
        <li class="tarjeta tarjeta-estado-entregada">
          <p class="tarjeta-titulo"><%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <p><%= d.entregadaTexto %> · Código <%= d.codigo %></p>
          <p>La entregó: <%= d.voluntario_nombre %> · La recibió: <%= d.recibido_por %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
