<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Por vencer · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Por vencer</h1>
  <p class="nota">Donaciones sin entregar a las que les falta una hora o menos para la hora límite.</p>

  <% if (donaciones.length === 0) { %>
    <p class="vacio">No hay donaciones por vencer en este momento.</p>
  <% } else { %>
    <ul class="lista-donaciones">
      <% donaciones.forEach((d) => { %>
        <li class="tarjeta tarjeta-estado-<%= d.estado %>">
          <p class="tarjeta-titulo"><%= d.codigo %> · <%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <p class="restante vence-pronto">Quedan <%= d.restante %></p>
          <p><%= d.estado === 'asignada' ? 'La tomó ' + d.voluntario_nombre : 'Nadie la ha tomado' %> · zona <%= d.zona %></p>
          <a class="boton" href="/donaciones/<%= d.codigo %>/avisar">Avisar por WhatsApp</a>
          <p><a href="/donaciones/<%= d.codigo %>">Ver detalle</a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <%# CA-21.8: alguien la tomó, pasó la hora límite y nadie registró la entrega. %>
  <h2>Tomadas sin entrega</h2>
  <p class="nota">Ya pasó su hora límite y nadie registró la entrega. Puede que la hayan entregado y olvidado registrarla.</p>
  <% if (sinEntrega.length === 0) { %>
    <p class="vacio">No hay donaciones tomadas sin entrega.</p>
  <% } else { %>
    <ul class="lista-donaciones">
      <% sinEntrega.forEach((d) => { %>
        <li class="tarjeta tarjeta-estado-vencida">
          <p class="tarjeta-titulo"><%= d.codigo %> · <%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <p class="restante vence-pronto">Venció hace <%= d.vencioHace %></p>
          <p>La tomó <%= d.voluntario_nombre %> · zona <%= d.zona %></p>
          <p>Teléfono: <%- include('_telefono', { telefono: d.voluntario_telefono, sinTelefono: 'Sin teléfono registrado' }) %></p>
          <% if (d.enlace) { %>
            <a class="boton boton-whatsapp" href="<%= d.enlace %>" rel="noopener">Recordarle por WhatsApp</a>
          <% } %>
          <p><a href="/donaciones/<%= d.codigo %>">Ver detalle: registrar la entrega en su nombre o liberarla</a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
