<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inicio · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <header class="portada">
    <h1 class="hero">Rescate de Alimentos</h1>
    <p class="saludo">Hola, <strong><%= usuario.nombre %></strong> (<%= usuario.rol %>).</p>
  </header>

  <% if (locals.aviso) { %><p class="exito" role="status"><%= aviso %></p><% } %>

  <%# Los iconos son solo adorno (aria-hidden): el texto de cada acceso dice lo mismo. %>
  <nav class="acciones" aria-label="Acciones">
    <% if (usuario.rol === 'donante') { %>
      <a class="accion principal" href="/donaciones/nueva">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
        Publicar donación
      </a>
      <a class="accion" href="/mis-donaciones">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        Mis donaciones
      </a>
    <% } %>

    <% if (usuario.rol === 'voluntario') { %>
      <a class="accion principal" href="/disponibles">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        Donaciones disponibles
      </a>
      <a class="accion" href="/mis-recogidas">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8"/></svg>
        Mis recogidas
      </a>
    <% } %>

    <% if (usuario.rol === 'organizacion') { %>
      <a class="accion principal" href="/para-recibir">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        Donaciones para recibir
      </a>
      <a class="accion" href="/vienen">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z"/></svg>
        Vienen para nosotros
      </a>
      <a class="accion" href="/recibidas">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12l5 5L20 7"/></svg>
        Recibidas
      </a>
    <% } %>

    <% if (usuario.rol === 'coordinadora') { %>
      <a class="accion principal" href="/donaciones/nueva">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
        Registrar donación de un comercio
      </a>
      <a class="accion" href="/todas">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4h6v3H9zM7 5H5v16h14V5h-2M8 12h8M8 16h5"/></svg>
        Todas las donaciones
      </a>
      <a class="accion" href="/reporte">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
        Reporte del periodo
      </a>
    <% } %>

    <a class="accion" href="/buscar">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg>
      Buscar donación por código
    </a>
  </nav>

  <% if (usuario.rol === 'coordinadora') { %>
    <h2>Administración</h2>
    <nav class="acciones" aria-label="Administración">
      <a class="accion" href="/usuarios">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.5a3.5 3.5 0 010 7M18 14.5c2 .7 3.5 2.6 3.5 5.5"/></svg>
        Usuarios
      </a>
      <a class="accion" href="/organizaciones">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/></svg>
        Organizaciones
      </a>
      <a class="accion" href="/zonas">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.5-7-12a7 7 0 0114 0c0 5.5-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
        Zonas
      </a>
    </nav>
  <% } %>

  <p><a class="boton boton-secundario" href="/mi-pin">Cambiar mi PIN</a></p>

  <form class="salir" method="post" action="/salir">
    <button type="submit" class="secundario">Salir</button>
  </form>
</body>
</html>
