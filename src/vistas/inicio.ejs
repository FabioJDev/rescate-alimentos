<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inicio · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <h1>Rescate de Alimentos</h1>
  <p>Hola, <strong><%= usuario.nombre %></strong> (<%= usuario.rol %>).</p>

  <% if (usuario.rol === 'donante') { %>
    <p><a class="boton" href="/donaciones/nueva">Publicar donación</a></p>
  <% } %>

  <form method="post" action="/salir">
    <button type="submit">Salir</button>
  </form>
</body>
</html>
