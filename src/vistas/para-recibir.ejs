<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Donaciones para recibir · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Donaciones para recibir</h1>
  <p class="nota"><%= organizacion.nombre %> · <%= organizacion.refrigeracion ? 'con refrigeración' : 'sin refrigeración: no se muestran lácteos ni cárnicos' %></p>

  <% if (donaciones.length === 0) { %>
    <p class="vacio">No hay donaciones para pedir en este momento.</p>
  <% } else { %>
    <ul class="lista-donaciones">
      <% donaciones.forEach((d) => { %>
        <li class="tarjeta<%= d.estado === 'asignada' ? ' tarjeta-estado-asignada' : '' %>">
          <p class="tarjeta-titulo"><%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <p>Zona <%= d.zona %> · <%= d.estado === 'asignada' ? 'Ya va un voluntario a recogerla' : 'Quedan ' + d.restante + ' para recogerla' %></p>
          <a class="boton" href="/donaciones/<%= d.codigo %>/pedir">Pedir para nosotros</a>
          <p><a href="/donaciones/<%= d.codigo %>">Ver detalle</a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
