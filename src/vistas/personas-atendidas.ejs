<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Personas atendidas · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Personas atendidas</h1>
  <p class="nota">Una cifra por organización y por día: cuántas personas atendieron ese día. No se piden nombres ni documentos.</p>

  <% if (aviso) { %><p class="exito" role="status"><%= aviso %></p><% } %>

  <% if (existente) { %>
    <%# CA-20.2: no se suma; se ofrece corregir la cifra que ya existe. %>
    <div class="aviso" role="alert">
      <p>Ya se registraron <strong><%= existente.personas %></strong> personas para el <%= existente.fecha %>. Si es un error, corrígelo.</p>
      <form method="post" action="/personas-atendidas">
        <input type="hidden" name="accion" value="corregir">
        <input type="hidden" name="fecha" value="<%= valores.fecha %>">
        <input type="hidden" name="personas" value="<%= valores.personas %>">
        <input type="hidden" name="organizacion_id" value="<%= valores.organizacion_id %>">
        <button type="submit">Corregir a <%= valores.personas %> personas</button>
      </form>
    </div>
  <% } %>

  <% if (Object.keys(errores).length > 0) { %>
    <p class="error" role="alert">No se guardó. Revisa los campos marcados.</p>
  <% } %>

  <form method="post" action="/personas-atendidas" novalidate>
    <% if (esCoordinadora) { %>
      <label for="organizacion_id">Organización</label>
      <select id="organizacion_id" name="organizacion_id" required>
        <option value="">Elige una organización</option>
        <% organizaciones.forEach((o) => { %>
          <option value="<%= o.id %>" <%= valores.organizacion_id === String(o.id) ? 'selected' : '' %>><%= o.nombre %></option>
        <% }) %>
      </select>
      <% if (errores.organizacion_id) { %><p class="error-campo" role="alert"><%= errores.organizacion_id %></p><% } %>
    <% } %>

    <label for="fecha">Día</label>
    <input id="fecha" name="fecha" type="date" value="<%= valores.fecha %>" required>
    <% if (errores.fecha) { %><p class="error-campo" role="alert"><%= errores.fecha %></p><% } %>

    <label for="personas">¿Cuántas personas atendieron ese día?</label>
    <input id="personas" name="personas" type="text" inputmode="numeric" value="<%= valores.personas %>" required>
    <% if (errores.personas) { %><p class="error-campo" role="alert"><%= errores.personas %></p><% } %>

    <button type="submit">Guardar</button>
  </form>

  <h2>Últimos 30 días</h2>
  <% if (recientes.length === 0) { %>
    <p class="vacio">Todavía no hay cifras registradas.</p>
  <% } else { %>
    <ul class="resumen">
      <% recientes.forEach((a) => { %>
        <li><%= a.fechaTexto %><%= esCoordinadora ? ' · ' + a.organizacion : '' %>: <strong><%= a.personas %></strong> personas
          <span class="nota">(registró <%= a.registrada_por %><%= a.corregida_por ? '; corrigió ' + a.corregida_por : '' %>)</span></li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
