<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mis recogidas · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Mis recogidas</h1>

  <% if (recogidas.length === 0) { %>
    <p class="vacio">No tienes recogidas pendientes.</p>
  <% } else { %>
    <ul class="lista-donaciones">
      <% recogidas.forEach((d) => { %>
        <li class="tarjeta tarjeta-estado-asignada">
          <p class="tarjeta-titulo"><%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <p>Código: <%= d.codigo %></p>
          <p>Recoger en: <%= d.punto_recogida %> (zona <%= d.zona %>)</p>
          <p>Hora límite: <%= d.horaLimiteTexto %></p>
          <p>Teléfono de <%= d.donante_nombre %>: <%- include('_telefono', { telefono: d.donante_telefono, sinTelefono: 'El comercio no tiene teléfono registrado' }) %></p>
          <a class="boton" href="/donaciones/<%= d.codigo %>/entregar">Registrar entrega</a>
          <p><a href="/donaciones/<%= d.codigo %>/soltar">No puedo recogerla: soltar</a></p>
          <p><a href="/donaciones/<%= d.codigo %>">Ver estado e historial</a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>

</body>
</html>
