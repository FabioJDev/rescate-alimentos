<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Donaciones disponibles · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Donaciones disponibles</h1>

  <%# CA-02.3 y CA-02.6: por defecto la zona propia; también se puede ver todas o elegir cualquier otra zona activa. %>
  <p class="filtro">
    <% if (verTodas) { %>
      Mostrando todas las zonas.
    <% } else { %>
      Mostrando zona <strong><%= zonaElegida %></strong><%= zonaVoluntario && zonaElegida === zonaVoluntario ? ' (la tuya)' : '' %>.
    <% } %>
  </p>
  <form method="get" action="/disponibles" class="filtro-zona">
    <label for="zona">Ver zona</label>
    <select id="zona" name="zona">
      <% if (zonaVoluntario) { %>
        <option value="<%= zonaVoluntario %>" <%= !verTodas && zonaElegida === zonaVoluntario ? 'selected' : '' %>>Mi zona (<%= zonaVoluntario %>)</option>
      <% } %>
      <option value="todas" <%= verTodas ? 'selected' : '' %>>Todas las zonas</option>
      <% zonasActivas.filter((z) => z !== zonaVoluntario).forEach((z) => { %>
        <option value="<%= z %>" <%= !verTodas && zonaElegida === z ? 'selected' : '' %>><%= z %></option>
      <% }) %>
    </select>
    <button type="submit">Ver</button>
  </form>

  <% if (donaciones.length === 0) { %>
    <p class="vacio">No hay donaciones disponibles en este momento</p>
  <% } else { %>
    <ul class="lista-donaciones">
      <% donaciones.forEach((d) => { %>
        <li class="tarjeta">
          <p class="tarjeta-titulo"><%= d.tipo_alimento %> · <%= d.cantidad %> <%= d.unidad %></p>
          <p>Recoger en: <%= d.punto_recogida %> (zona <%= d.zona %>)</p>
          <p>Hora límite: <%= d.horaLimiteTexto %></p>
          <p class="restante<%= d.vencePronto ? ' vence-pronto' : '' %>">Quedan <%= d.restante %><% if (d.vencePronto) { %> · Vence pronto<% } %></p>
          <% if (d.tiene_foto) { %><p class="nota">Tiene foto: ábrela en «Ver detalle».</p><% } %>
          <%- include('_destino', { d }) %>
          <a class="boton" href="/donaciones/<%= d.codigo %>/tomar">Tomar</a>
          <p><a href="/donaciones/<%= d.codigo %>">Ver detalle</a></p>
        </li>
      <% }) %>
    </ul>
  <% } %>

</body>
</html>
