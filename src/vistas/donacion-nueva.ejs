<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Publicar donación · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
  <script src="/foto.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Publicar donación</h1>

  <% if (Object.keys(errores).length > 0) { %>
    <p class="error" role="alert">No se registró la donación. Revisa los campos marcados.</p>
  <% } %>

  <%# data-sin-conexion: el script del teléfono guarda aquí la donación si no hay señal (CMP-08, ADR-004). %>
  <form method="post" action="/donaciones" novalidate data-sin-conexion data-usuario="<%= locals.usuarioActual ? usuarioActual.id : '' %>">
    <% if (comercios) { %>
      <label for="donante_id">Comercio que avisó la donación</label>
      <select id="donante_id" name="donante_id" required>
        <option value="">Elige un comercio</option>
        <% comercios.forEach((c) => { %>
          <option value="<%= c.id %>" <%= String(c.id) === valores.donante_id ? 'selected' : '' %>><%= c.nombre %></option>
        <% }) %>
      </select>
      <% if (errores.donante_id) { %><p class="error-campo" role="alert"><%= errores.donante_id %></p><% } %>
    <% } %>

    <label for="tipo_alimento">Tipo de alimento</label>
    <select id="tipo_alimento" name="tipo_alimento" required>
      <option value="">Elige una opción</option>
      <% tipos.forEach((tipo) => { %>
        <option value="<%= tipo %>" <%= valores.tipo_alimento === tipo ? 'selected' : '' %>><%= tipo %></option>
      <% }) %>
    </select>
    <% if (errores.tipo_alimento) { %><p class="error-campo" role="alert"><%= errores.tipo_alimento %></p><% } %>

    <label for="cantidad">Cantidad aproximada</label>
    <input id="cantidad" name="cantidad" type="text" inputmode="decimal" value="<%= valores.cantidad %>" required>
    <% if (errores.cantidad) { %><p class="error-campo" role="alert"><%= errores.cantidad %></p><% } %>

    <label for="unidad">Unidad</label>
    <select id="unidad" name="unidad" required>
      <% unidades.forEach((unidad) => { %>
        <option value="<%= unidad %>" <%= valores.unidad === unidad ? 'selected' : '' %>><%= unidad %></option>
      <% }) %>
    </select>
    <% if (errores.unidad) { %><p class="error-campo" role="alert"><%= errores.unidad %></p><% } %>

    <%# CA-22.1: opcional; con la unidad kg no hace falta (el peso es la cantidad). %>
    <label for="kg_aproximados">Peso aproximado en kg (opcional, si la unidad no es kg)</label>
    <input id="kg_aproximados" name="kg_aproximados" type="text" inputmode="decimal" value="<%= valores.kg_aproximados || '' %>">
    <% if (errores.kg_aproximados) { %><p class="error-campo" role="alert"><%= errores.kg_aproximados %></p><% } %>

    <label for="punto_recogida">Punto de recogida<% if (comercios) { %> (si lo dejas vacío, se usa la dirección del comercio)<% } %></label>
    <input id="punto_recogida" name="punto_recogida" type="text" value="<%= valores.punto_recogida %>" <%= comercios ? '' : 'required' %>>
    <% if (errores.punto_recogida) { %><p class="error-campo" role="alert"><%= errores.punto_recogida %></p><% } %>

    <label for="hora_limite">Hora límite para recoger</label>
    <input id="hora_limite" name="hora_limite" type="datetime-local" value="<%= valores.hora_limite %>" required>
    <% if (errores.hora_limite) { %><p class="error-campo" role="alert"><%= errores.hora_limite %></p><% } %>

    <%# CA-23.1: opcional. El teléfono la achica antes de enviarla (foto.js); viaja en el campo oculto «foto». %>
    <div class="campo-foto" data-foto>
      <label for="elegir_foto">Foto (opcional)</label>
      <input id="elegir_foto" type="file" accept="image/jpeg,image/png,image/webp">
      <input type="hidden" name="foto" value="">
      <img alt="Vista previa de la foto" hidden>
      <p class="nota" data-foto-estado role="status"></p>
      <button type="button" class="secundario" data-foto-quitar hidden>Quitar foto</button>
      <% if (errores.foto) { %><p class="error-campo" role="alert"><%= errores.foto %></p><% } %>
    </div>

    <button type="submit">Publicar donación</button>
  </form>

</body>
</html>
