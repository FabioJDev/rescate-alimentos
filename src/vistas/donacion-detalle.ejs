<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Donación <%= donacion.codigo %> · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca') %>
  <h1>Donación <%= donacion.codigo %></h1>
  <p class="estado <%= donacion.vencida ? 'estado-vencida' : 'estado-' + donacion.estado %>">Estado: <strong><%= estadoTexto %></strong></p>

  <div class="tarjeta tarjeta-<%= donacion.vencida ? 'estado-vencida' : 'estado-' + donacion.estado %>">
    <p class="tarjeta-titulo"><%= donacion.tipo_alimento %> · <%= donacion.cantidad %> <%= donacion.unidad %></p>
    <p>Donante: <%= donacion.donante_nombre %></p>
    <p>Recoger en: <%= donacion.punto_recogida %> (zona <%= donacion.zona %>)</p>
    <p>Hora límite: <%= horaLimite %></p>
    <% if (donacion.estado === 'cancelada') { %><p>Motivo de la cancelación: <%= donacion.motivo_cancelacion %></p><% } %>
  </div>

  <% if (contactos.length > 0) { %>
    <h2>Contacto</h2>
    <ul class="contactos">
      <% contactos.forEach((c) => { %>
        <li><%= c.etiqueta %>: <strong><%= c.nombre %></strong> · <%- include('_telefono', { telefono: c.telefono, sinTelefono: 'sin teléfono registrado' }) %></li>
      <% }) %>
    </ul>
  <% } %>

  <%# CMP-14: lo que la coordinadora puede hacer cuando una donación está trabada. %>
  <% if (locals.usuarioActual && usuarioActual.rol === 'coordinadora') { %>
    <% if (donacion.estado === 'asignada') { %>
      <p>Tomada por: <strong><%= donacion.voluntario_nombre %></strong></p>
      <p>
        <a class="boton" href="/donaciones/<%= donacion.codigo %>/entregar-por">Registrar entrega en su nombre</a>
        <a class="boton boton-secundario" href="/donaciones/<%= donacion.codigo %>/asignar">Asignar a otro voluntario</a>
        <a class="boton boton-secundario" href="/donaciones/<%= donacion.codigo %>/liberar">Liberar</a>
      </p>
    <% } else if (donacion.estado === 'disponible' && !donacion.vencida) { %>
      <p><a class="boton boton-secundario" href="/donaciones/<%= donacion.codigo %>/asignar">Asignar a un voluntario</a></p>
    <% } %>
  <% } %>

  <% if (puedeCorregir || puedeCancelar) { %>
    <p>
      <% if (puedeCorregir) { %><a class="boton boton-secundario" href="/donaciones/<%= donacion.codigo %>/corregir">Corregir datos</a><% } %>
      <% if (puedeCancelar) { %><a class="boton boton-secundario" href="/donaciones/<%= donacion.codigo %>/cancelar">Cancelar donación</a><% } %>
    </p>
  <% } %>

  <h2>Historial</h2>
  <ol class="historial">
    <% historial.forEach((paso) => { %>
      <li><strong><%= paso.cuando %></strong><br><%= paso.texto %></li>
    <% }) %>
  </ol>

  <p><a class="boton boton-secundario" href="/buscar">Buscar otra donación</a></p>
</body>
</html>
