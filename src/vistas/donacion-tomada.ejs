<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Rescate de Alimentos</title>
  <link rel="stylesheet" href="/estilos.css">
  <script src="/interaccion.js" defer></script>
</head>
<body>
  <%- include('_marca', { volverA: '/disponibles', volverNombre: 'Donaciones' }) %>
  <h1><%= titulo %></h1>
  <p class="exito">La donación <strong><%= donacion.codigo %></strong> es tuya. Ve a recogerla.</p>

  <div class="tarjeta tarjeta-estado-asignada">
    <p class="tarjeta-titulo"><%= donacion.tipo_alimento %> · <%= donacion.cantidad %> <%= donacion.unidad %></p>
    <p>Recoger en: <%= donacion.punto_recogida %> (zona <%= donacion.zona %>)</p>
    <p>Hora límite: <%= horaLimite %></p>
    <p>Teléfono de <%= donacion.donante_nombre %>: <%- include('_telefono', { telefono: donacion.donante_telefono, sinTelefono: 'El comercio no tiene teléfono registrado' }) %></p>
    <%- include('_destino', { d: donacion }) %>
  </div>

  <p><a class="boton" href="/mis-recogidas">Ver mis recogidas</a></p>
  <p><a href="/donaciones/<%= donacion.codigo %>">Ver estado e historial</a></p>
</body>
</html>
